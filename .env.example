# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables.

# Your site's public address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack > Settings > API Keys & Webhooks. Use TEST keys (sk_test_ / pk_test_).
PAYSTACK_SECRET_KEY=sk_test_
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_

# Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=

# Optional: Resend (https://resend.com) for receipts and notifications.
# Without it, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Dreamer <hello@example.com>"

# Optional: protects the daily expiry job. Any long random string.
CRON_SECRET=

# Optional: put submitted needs live straight away in escrow (funds held until verified).
ESCROW_AUTO_PUBLISH=
# Recommended: long random string for fingerprinting ID numbers and banned identities. Never change it once set.
IDENTITY_SALT=
# Optional: AI photo screening (https://sightengine.com)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
MODERATION_AUTO_APPROVE=
# Optional: automatic NIN checks (https://dojah.io)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Optional: signs the links givers use to choose a refund or redirect (defaults to the service role key)
CONSENT_SECRET=
# Optional: SMS update reminders through Termii
TERMII_API_KEY=
TERMII_SENDER_ID=Dreamer
